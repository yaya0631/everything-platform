{
  "name": "platform",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Self-hosted cloud for the CAD app: accounts, a drive, sharing, live co-editing, AI, email and hosted apps on your own computer.",
  "scripts": {
    "setup": "npm install && npm --prefix ../upstream/src/cad install && npm --prefix ../upstream/src/cad run build",
    "build": "npm --prefix ../upstream/src/cad run build",
    "start": "node server.js",
    "engines:install": "node engines/install.mjs",
    "engines:check": "node engines/install.mjs --check",
    "e2e:engines": "node engine-e2e.mjs",
    "e2e:pyodide": "node pyodide-e2e.mjs",
    "user": "node users.js",
    "app": "node apps.js",
    "hub": "node hub.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "nodemailer": "^10.1.7",
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "puppeteer-core": "^25.15.0"
  }
}
